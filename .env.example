# Copiez vers .env puis renseignez (ne jamais committer .env) :
#   cp .env.example .env
#
# Générer une clé Django :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Dev : laissez vide (fallback local). Prod : OBLIGATOIRE, 50+ caractères aléatoires.
DJANGO_SECRET_KEY=
# 1 en dev, 0 en prod.
DJANGO_DEBUG=1
# Séparés par virgules. Ex prod : DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Origines CSRF prod, séparées par virgules. Ex : https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Dev : vide ou sqlite:///db.sqlite3. Prod : postgres://USER:PASS@HOST:5432/DB
DATABASE_URL=
